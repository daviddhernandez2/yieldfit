{
  "permissions": {
    "ask": [
      "Bash(git add *)",
      "Bash(git apply *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git clean *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Bash(git -C *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirmar-git.mjs\""
          }
        ]
      }
    ]
  }
}
