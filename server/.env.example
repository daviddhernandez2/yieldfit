PORT=3000
NODE_ENV=development
# En local, SIEMPRE la base de desarrollo (yieldfit-dev) con el usuario de Atlas de
# desarrollo, que solo tiene readWrite sobre yieldfit-dev. Si NODE_ENV no es
# production y la base es "yieldfit", el servidor se niega a arrancar.
# En Render: la base "yieldfit" con el usuario de producción.
MONGO_URI=mongodb+srv://USUARIO_DEV:CONTRASEÑA@cluster0.xxxxx.mongodb.net/yieldfit-dev?retryWrites=true&w=majority
JWT_SECRET=GENERA_TU_SECRET_CON_NODE_E_REQUIRE_CRYPTO_RANDOMBYTES_64_TOSTRING_HEX
# Orígenes permitidos por CORS separados por comas. Obligatoria: sin ella el servidor no arranca.
# Ejemplo prod: CLIENT_ORIGINS=https://yieldfit.vercel.app
CLIENT_ORIGINS=http://localhost:5173
# Opcional, solo local: retrasa cada petición N ms para probar el aviso de arranque
# en frío (bloque 3). Se ignora siempre con NODE_ENV=production. Mejor pasarla al
# arrancar que dejarla aquí: RETRASO_PRUEBA_MS=8000 npm run dev
# RETRASO_PRUEBA_MS=8000
# Opcional: cuántos proxies de confianza hay delante del servidor (por defecto 1, el de
# Render). Afecta a req.ip y, con ella, al límite de intentos del login y el registro.
# TRUST_PROXY=1
# Opcional, solo local: duración del token de acceso para probar la renovación (bloque 11),
# p. ej. 20s. Se ignora siempre con NODE_ENV=production. Mejor pasarla al arrancar:
# DURACION_ACCESO_PRUEBA=20s npm run dev

